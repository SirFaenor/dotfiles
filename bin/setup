#!/bin/bash
#
# Install dotfiles
# partial credits: https://github.com/freekmurze/dotfiles/blob/main/bin/install

set -e  # Exit on error (but we use || true for optional steps)

# Colors
BLUE='\033[0;34m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

DOTFILES_DIR="$HOME/Dotfiles"

step() { echo ""; echo -e "${BLUE}➜${NC} $1 ..."; }
success() { echo -e "${GREEN}✓${NC} ... $1"; }
warn() { echo -e "${YELLOW}⚠${NC} $1"; }
error() { echo -e "${RED}✗${NC} $1"; exit 1; }
echo ""
step "Install Dotfiles"
echo ""
warn "This will install/update your terminal setup"
echo ""
read -p "Continue? (y/n) " -n 1 -r
echo ""

if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo ""
    step "Cancelled"
    echo ""
    exit 0
fi

# install oh my zsh
step "Installing Oh My Zsh"
if [ ! -d ~/.oh-my-zsh ]; then
    rm -rf ~/.oh-my-zsh
    curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh | sh -s -- --unattended || warn "Oh My Zsh installation failed"
fi
success "Oh My Zsh installed"

# make Zsh default
step "Setting Zsh as default shell"
chsh -s $(which zsh)
success ok

# Symlinks
step "Creating symlinks"

rm -f ~/.zshrc ~/.bashrc ~/.bash_aliases
ln -sf ~/Dotfiles/home/.zshrc ~/.zshrc
ln -sf ~/Dotfiles/home/.bashrc ~/.bashrc
ln -sf ~/Dotfiles/home/.bashrc ~/.bash_aliases
ln -sf ~/Dotfiles/home/.bashrc ~/.bash_aliases

success "ok"


# Claude configuration
if [ -d "$DOTFILES_DIR/config/claude" ]; then
    step "Setting up Claude Code configuration"
    mkdir -p ~/.claude

    # Symlink configuration files
    ln -sf "$DOTFILES_DIR/config/claude/CLAUDE.md" ~/.claude/CLAUDE.md
    # ln -sf "$DOTFILES_DIR/config/claude/laravel-php-guidelines.md" ~/.claude/laravel-php-guidelines.md
    ln -sf "$DOTFILES_DIR/config/claude/settings.json" ~/.claude/settings.json
    ln -sf "$DOTFILES_DIR/config/claude/statusline.sh" ~/.claude/statusline.sh

    # Symlink entire skills directory
    rm -rf ~/.claude/skills
    ln -sf "$DOTFILES_DIR/config/claude/skills" ~/.claude/skills

    # Symlink entire agents directory
    rm -rf ~/.claude/agents
    ln -sf "$DOTFILES_DIR/config/claude/agents" ~/.claude/agents

    # Symlink entire memory directory
    rm -rf ~/.claude/memory
    ln -sf "$DOTFILES_DIR/config/claude/memory" ~/.claude/memory

    success "Claude Code configured"
else
    warn "Dotfiles directory not found, skipping configuration"
    echo "  To set up configuration later, clone dotfiles to ~/Dotfiles"
fi

# ln -sf ~/.dotfiles/home/.vimrc ~/.vimrc
# ln -sf ~/.dotfiles/home/.vim ~/.vim
# ln -sf ~/.dotfiles/macos/.mackup.cfg ~/.mackup.cfg
# mkdir -p ~/bin
# ln -sf ~/.dotfiles/bin/php-format ~/bin/php-format
# mkdir -p ~/.config/zed
# ln -sf ~/.dotfiles/config/zed/settings.json ~/.config/zed/settings.json
# ln -sf ~/.dotfiles/config/zed/keymap.json ~/.config/zed/keymap.json
# mkdir -p ~/.config/ghostty
# ln -sf ~/.dotfiles/config/ghostty/config ~/.config/ghostty/config
# success "Symlinks created"
